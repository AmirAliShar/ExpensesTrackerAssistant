# ==============================================================================
# FinPilot AI — Agentic Personal Finance Assistant Configuration Template
# Placeholders only. Copy to .env and fill in your actual credentials.
# ==============================================================================

# Application Configuration
APP_NAME=AI Expense Tracker
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Mandatory - SQLite fallback is disabled)
# Precedence: DATABASE_URL takes priority if specified.
# ------------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_database_user
PGPASSWORD=change_me
DATABASE_URL=

# ------------------------------------------------------------------------------
# Groq Chat Models & Dynamic Fallback Selection
# Candidates: llama-3.1-8b-instant -> llama-3.3-70b-versatile -> openai/gpt-oss-120b
# ------------------------------------------------------------------------------
GROQ_API_KEY=YOUR_GROQ_API_KEY
PRIMARY_CHAT_PROVIDER=groq
PRIMARY_CHAT_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
MODEL_MAX_RETRIES=2
MODEL_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Voice Services (Whisper STT & Neural TTS)
# ------------------------------------------------------------------------------
GROQ_STT_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=edge-tts
TTS_MODEL=en-US-ChristopherNeural

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# FastMCP Tool Server
# ------------------------------------------------------------------------------
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp

# ------------------------------------------------------------------------------
# Agent System Prompts & Orchestration Overrides
# Leave blank to use safe version-controlled defaults.
# ------------------------------------------------------------------------------
AGENT_PROMPTS_FROM_ENV=true
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=60
FINANCE_SUPERVISOR_PROMPT=
EXPENSE_AGENT_PROMPT=
BUDGET_AGENT_PROMPT=
ANALYTICS_AGENT_PROMPT=
MEMORY_AGENT_PROMPT=
VOICE_AGENT_PROMPT=
